---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import EntryCard from "../../components/EntryCard.astro";

const notes = (await getCollection("notes", ({ data }) => data.status === "published")).sort(
  (a, b) => (b.data.updated ?? b.data.date).getTime() - (a.data.updated ?? a.data.date).getTime(),
);
---

<BaseLayout title="Notes | Yuhang Wu" active="notes">
  <TopBar label="Notes" searchable />
  <section class="intro-panel">
    <p class="section-label">Notes</p>
    <h2>Technical fragments, learning notes, and reflections.</h2>
    <p>This section is for thoughts that are allowed to evolve instead of being compressed into polished resume language.</p>
  </section>
  <section class="feed-section">
    <div class="entry-feed">
      {notes.map((entry) => <EntryCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
