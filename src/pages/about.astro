---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import EntryCard from "../components/EntryCard.astro";
import ResumeSection from "../components/ResumeSection.astro";
import { getAllPublishedEntries } from "../lib/content";
import profile from "../../content/resume/profile.json";

const entries = await getAllPublishedEntries();
const selected = entries.filter((entry) => entry.data.featured).slice(0, 3);
---

<BaseLayout title="About | Yuhang Wu" active="about" contentClass="detail-content">
  <TopBar label="Home › About" />
  <article class="detail-article">
    <header class="detail-hero">
      <p class="section-label">About</p>
      <h2>{profile.name}</h2>
      <p>{profile.summary}</p>
      <div class="detail-actions">
        <a class="button primary" href={profile.cv} target="_blank" rel="noreferrer">Download CV</a>
        <a class="button secondary" href={`mailto:${profile.email}`}>Email</a>
        <a class="button ghost" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </header>

    <ResumeSection title="Now">
      <p>Building applied AI and data systems while shaping this website into a personal archive for work, learning, and life.</p>
    </ResumeSection>

    <ResumeSection title="Experience">
      {profile.experience.map((item) => (
        <div class="resume-item">
          <div class="entry-meta">
            <span>{item.company} - {item.role}</span>
            <span>{item.period}</span>
          </div>
          <p>{item.summary}</p>
          <ul>
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
      ))}
    </ResumeSection>

    <ResumeSection title="Selected Work">
      <div class="entry-feed compact-feed">
        {selected.map((entry) => <EntryCard entry={entry} />)}
      </div>
    </ResumeSection>

    <ResumeSection title="Core Competencies">
      <div class="skill-grid compact-skills">
        {profile.skills.map((skill) => (
          <article>
            <h4>{skill.name}</h4>
            <p>{skill.items}</p>
          </article>
        ))}
      </div>
    </ResumeSection>

    <ResumeSection title="Education">
      {profile.education.map((item) => (
        <div class="resume-item">
          <div class="entry-meta">
            <span>{item.school} - {item.degree}</span>
            <span>{item.period}</span>
          </div>
          <p>{item.details}</p>
        </div>
      ))}
    </ResumeSection>
  </article>
</BaseLayout>
