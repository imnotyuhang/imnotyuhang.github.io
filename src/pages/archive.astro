---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import RightRail from "../components/RightRail.astro";
import { entryDate, entryDateLabel, entryHref, getAllPublishedEntries, groupEntriesByYear } from "../lib/content";

const entries = await getAllPublishedEntries();
const yearGroups = groupEntriesByYear(entries);
---

<BaseLayout title="Archive | Yuhang Wu" active="archive">
  <TopBar crumbs={[{ label: "Home", href: "/" }, { label: "Archive" }]} searchable />

  <section class="directory-section" aria-labelledby="archive-title">
    <div class="section-heading compact-heading">
      <p class="section-label">Archive</p>
      <h2 id="archive-title">Everything in time order.</h2>
    </div>

    <div class="archive-list">
      {yearGroups.map(({ year, entries: yearEntries }) => (
        <section class="archive-year" aria-labelledby={`year-${year}`}>
          <h3 id={`year-${year}`}>{year}</h3>
          <div class="timeline-list">
            {yearEntries.map((entry) => (
              <a class="archive-row timeline-entry" href={entryHref(entry)} data-entry data-type={entry.data.type} data-category={entry.data.category} data-tags={`${entry.data.title} ${entry.data.summary} ${entry.data.tags.join(" ")}`.toLowerCase()}>
                <span class="timeline-node" aria-hidden="true"></span>
                <span class="archive-date">
                  <time datetime={entryDate(entry).toISOString()}>{entryDateLabel(entry)}</time>
                </span>
                <span class="archive-copy">
                  <strong>{entry.data.title}</strong>
                  <span>{entry.data.summary}</span>
                </span>
                <small class="archive-type">{entry.data.type}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <RightRail slot="rail" entries={entries} />
</BaseLayout>
