---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import Toc from "../../components/Toc.astro";
import { formatDate, getCategory } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("entries", ({ data }) => data.status === "published");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const category = getCategory(entry.data.category);
const typeLabel = entry.data.type.charAt(0).toUpperCase() + entry.data.type.slice(1);
---

<BaseLayout title={`${entry.data.title} | Yuhang Wu`} active="categories" detail contentClass="detail-content">
  <article class="detail-article">
    <header class="detail-hero">
      <p class="section-label">{typeLabel} / {category?.title ?? entry.data.category}</p>
      <h2>{entry.data.title}</h2>
      <p>{entry.data.summary}</p>
      <div class="entry-meta">
        <span>{formatDate(entry.data.updated ?? entry.data.date)}</span>
        {entry.data.tools && entry.data.tools.length > 0 ? <span>{entry.data.tools.join(" / ")}</span> : <span>{typeLabel}</span>}
      </div>
      <TagList tags={entry.data.tags} />
    </header>

    {entry.data.problem && (
      <section class="detail-section">
        <h3>Problem</h3>
        <p>{entry.data.problem}</p>
      </section>
    )}
    {entry.data.approach && (
      <section class="detail-section">
        <h3>Approach</h3>
        <p>{entry.data.approach}</p>
      </section>
    )}
    {entry.data.result && (
      <section class="detail-section">
        <h3>Result</h3>
        <p>{entry.data.result}</p>
      </section>
    )}
    {entry.data.next && (
      <section class="detail-section">
        <h3>Next</h3>
        <p>{entry.data.next}</p>
      </section>
    )}
    <section class="detail-section article-body">
      <Content />
    </section>
  </article>
  <Toc slot="rail" headings={headings} />
</BaseLayout>
