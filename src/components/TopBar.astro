---
interface Props {
  crumbs: {
    label: string;
    href?: string;
  }[];
  searchable?: boolean;
}

const { crumbs, searchable = false } = Astro.props;
---

<header class="top-bar" aria-label="Page context">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="breadcrumb-list">
      {crumbs.map((crumb, index) => {
        const isCurrent = index === crumbs.length - 1;
        return (
          <span class="breadcrumb-item">
            {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">&gt;</span>}
            {crumb.href && !isCurrent ? <a href={crumb.href}>{crumb.label}</a> : <span class="breadcrumb-current" aria-current={isCurrent ? "page" : undefined}>{crumb.label}</span>}
          </span>
        );
      })}
    </div>
  </nav>
  {searchable && (
    <label class="search-box">
      <span class="sr-only">Search entries</span>
      <input type="search" placeholder="Search entries, categories, tags..." data-search-input />
    </label>
  )}
</header>
