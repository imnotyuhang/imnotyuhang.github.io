---
import petsConfig from "../../content/pets/pets.json";

const pets = petsConfig.filter((pet) => pet.enabled);
---

<div class="pet-playground" data-pet-playground>
  <div class="pet-corner">
    {pets.map((pet) => (
      <button
        class:list={["wander-pet", `pet-${pet.id}`]}
        type="button"
        data-wander-pet
        data-pet-id={pet.id}
        data-animal={pet.species}
        data-pet-config={JSON.stringify({
          sprite: pet.sprite,
          actions: pet.actions,
        })}
        aria-label={`${pet.name} sticker`}
      >
        <span class="pet-sticker">
          {pet.sprite?.src ? (
            <span class="pet-viewport" aria-hidden="true">
              <span class="pet-sprite" style={`background-image: url("${pet.sprite.src}");`}></span>
            </span>
          ) : pet.asset ? (
            <img class="pet-image" src={pet.asset} alt="" loading="eager" />
          ) : pet.id === "calico" ? (
            <svg class="pet-svg" viewBox="0 0 150 150" role="presentation">
            <path class="pet-shadow" d="M28 133c21 10 80 10 101 0 8-4 6-11-3-14-24-8-72-8-96 0-9 3-10 10-2 14Z" />
            <path class="cat-tail patch-dark" d="M105 93c25-5 33-30 17-44-8-7-20-2-18 9 1 7 8 9 10 15 3 9-4 18-16 20" />
            <path class="pet-body fur-white" d="M39 87c3-28 20-44 40-44s37 16 40 44c4 32-12 48-40 48S35 119 39 87Z" />
            <path class="cat-patch patch-orange" d="M42 84c3-24 14-38 31-40-1 18-10 36-30 44Z" />
            <path class="cat-patch patch-dark" d="M76 44c19 0 32 15 38 34-14-4-27-17-38-34Z" />
            <path class="cat-ear left patch-orange" d="M49 54 35 24c-3-6 3-11 8-6l24 20Z" />
            <path class="cat-ear right patch-dark" d="M102 54 116 24c3-6-3-11-8-6L84 38Z" />
            <path class="pet-face fur-white" d="M43 61c9-22 26-32 36-32s27 10 36 32c7 18-5 36-36 36S36 79 43 61Z" />
            <path class="cat-face-patch patch-orange" d="M43 61c8-20 21-29 34-32-4 18-14 30-32 36Z" />
            <path class="cat-face-patch patch-dark" d="M80 29c17 3 28 14 35 32-15-1-27-12-35-32Z" />
            <path class="cat-stripe" d="M67 35c-3 7-6 12-11 17M79 31c0 10-1 17-4 25M91 38c3 7 7 13 13 18M45 73c8-1 14-3 19-7M94 66c5 4 11 6 19 7" />
            <path class="pet-chest" d="M62 93c6 8 27 8 33 0 0 17-7 28-17 28s-16-11-16-28Z" />
            <circle class="pet-eye left" cx="64" cy="69" r="6" />
            <circle class="pet-eye right" cx="92" cy="69" r="6" />
            <circle class="eye-shine left" cx="62" cy="67" r="2" />
            <circle class="eye-shine right" cx="90" cy="67" r="2" />
            <path class="pet-nose" d="M75 80c3-3 7-3 10 0-1 6-9 6-10 0Z" />
            <path class="pet-mouth" d="M80 86c-4 5-9 5-13 1M80 86c4 5 9 5 13 1" />
            <path class="pet-leg left fur-white" d="M54 116c-8 8-6 17 5 17h12v-22Z" />
            <path class="pet-leg right fur-white" d="M104 116c8 8 6 17-5 17H87v-22Z" />
            <path class="pet-paw left" d="M52 90c-11 1-18 8-16 17 2 9 15 11 23 4" />
            <path class="pet-paw right" d="M108 90c11 1 18 8 16 17-2 9-15 11-23 4" />
            </svg>
          ) : (
            <svg class="pet-svg" viewBox="0 0 150 150" role="presentation">
            <path class="pet-shadow" d="M26 134c22 10 82 10 104 0 8-4 7-11-3-14-26-8-74-8-100 0-10 3-11 10-1 14Z" />
            <path class="dog-tail fur-white" d="M111 88c18-18 34-7 26 11" />
            <path class="pet-body fur-white" d="M34 86c7-25 23-40 44-40s37 15 44 40c8 33-8 49-44 49S26 119 34 86Z" />
            <path class="dog-saddle patch-orange" d="M48 53c16-14 44-15 60 0-7 15-17 25-30 25S55 68 48 53Z" />
            <path class="dog-ear left patch-brown" d="M51 60c-23-4-29-29-16-40 17 3 31 18 33 38Z" />
            <path class="dog-ear right patch-brown" d="M104 60c23-4 29-29 16-40-17 3-31 18-33 38Z" />
            <path class="pet-face fur-white" d="M43 64c10-21 26-31 35-31s25 10 35 31c8 17-4 37-35 37S35 81 43 64Z" />
            <path class="dog-face-patch patch-orange" d="M48 56c9-15 20-23 30-23s22 8 30 23c-7 6-17 10-30 10s-23-4-30-10Z" />
            <path class="dog-spot patch-brown" d="M90 43c13 5 20 15 24 30-10 1-19-4-26-15Z" />
            <path class="pet-muzzle" d="M63 76c5-10 25-10 30 0 5 11-2 20-15 20s-20-9-15-20Z" />
            <circle class="pet-eye left" cx="65" cy="65" r="5" />
            <circle class="pet-eye right" cx="92" cy="65" r="5" />
            <circle class="eye-shine left" cx="63" cy="63" r="1.8" />
            <circle class="eye-shine right" cx="90" cy="63" r="1.8" />
            <path class="pet-nose" d="M73 77c4-4 10-4 14 0-2 7-12 7-14 0Z" />
            <path class="pet-mouth" d="M80 86c-3 6-9 7-14 3M80 86c3 6 9 7 14 3" />
            <path class="pet-leg left fur-white" d="M56 116c-8 8-6 17 5 17h13v-24Z" />
            <path class="pet-leg right fur-white" d="M103 116c8 8 6 17-5 17H85v-24Z" />
            <path class="pet-paw left" d="M51 91c-11 1-18 9-16 18 2 9 15 11 24 4" />
            <path class="pet-paw right" d="M109 91c11 1 18 9 16 18-2 9-15 11-24 4" />
            </svg>
          )}
        </span>
        <span class="pet-reaction"></span>
      </button>
    ))}
  </div>
</div>
