---
import type { SiteEntry } from "../lib/content";
import { categoryEntryCount, categoryHref, entryHref, entryUpdatedDate, getCategories } from "../lib/content";

interface Props {
  entries: SiteEntry[];
}

const { entries } = Astro.props;
const recent = [...entries].sort((a, b) => entryUpdatedDate(b).getTime() - entryUpdatedDate(a).getTime()).slice(0, 4);
const categories = getCategories();
const filters = ["All", "Projects", "Notes", "Life", "AI", "Vision", "Robotics"];
const filterValue = (label: string) => {
  if (label === "All") return "all";
  if (label === "Projects") return "project";
  if (label === "Notes") return "note";
  if (label === "Life") return "life";
  return label.toLowerCase();
};
---

<aside class="right-rail" aria-label="Site metadata">
  <section class="rail-card">
    <h2>Recently Updated</h2>
    {recent.map((entry) => <a href={entryHref(entry)}>{entry.data.title}</a>)}
  </section>

  <section class="rail-card">
    <h2>Categories</h2>
    <div class="focus-list">
      {categories.map((category) => (
        <a class="rail-pill" href={categoryHref(category)}>
          {category.title} <span>{categoryEntryCount(category, entries)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rail-card">
    <h2>Quick Filters</h2>
    <div class="filter-tags" data-filter-tags>
      {filters.map((label) => (
        <button type="button" class:list={[label === "All" && "is-active"]} data-filter={filterValue(label)}>
          {label}
        </button>
      ))}
    </div>
  </section>
</aside>
