---
import type { SiteEntry } from "../lib/content";
import { categoryEntryCount, categoryHref, entryHref, getCategories, getRecentUpdatedEntries } from "../lib/content";
import { siteConfig } from "../config/site";

interface Props {
  entries: SiteEntry[];
}

const { entries } = Astro.props;
const recent = getRecentUpdatedEntries(entries, siteConfig.rightRail.recentLimit);
const categories = getCategories();
---

<aside class="right-rail" aria-label="Site metadata">
  <section class="rail-card">
    <h2>Recently Updated</h2>
    {recent.map((entry) => <a href={entryHref(entry)}>{entry.data.title}</a>)}
  </section>

  <section class="rail-card">
    <h2>Categories</h2>
    <div class="focus-list">
      {categories.map((category) => (
        <a class="rail-pill" href={categoryHref(category)}>
          {category.title} <span>{categoryEntryCount(category, entries)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rail-card">
    <h2>Quick Filters</h2>
    <div class="filter-tags" data-filter-tags>
      {siteConfig.rightRail.filters.map((filter) => (
        <button type="button" class:list={[filter.value === "all" && "is-active"]} data-filter={filter.value}>
          {filter.label}
        </button>
      ))}
    </div>
  </section>
</aside>
