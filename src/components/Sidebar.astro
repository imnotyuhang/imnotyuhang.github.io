---
import { siteConfig, type ActiveNav } from "../config/site";
import profile from "../../content/resume/profile.json";

interface Props {
  active?: ActiveNav;
}

const { active = "home" } = Astro.props;
---

<aside class="sidebar" id="sidebar" aria-label="Site sidebar" data-sidebar>
  <a class="profile-photo-link" href="/" aria-label={`${siteConfig.title} home`}>
    <img class="profile-photo" src={siteConfig.assets.portrait} alt={profile.name} />
  </a>
  <div class="profile-copy">
    <p class="profile-kicker">{siteConfig.sidebar.kicker}</p>
    <h1><a href="/">{profile.name}</a></h1>
    <p>{siteConfig.sidebar.intro}</p>
  </div>

  <nav class="side-nav" aria-label="Main navigation">
    {siteConfig.nav.map((item) => (
      <a class:list={[active === item.id && "is-active"]} href={item.href}>{item.label}</a>
    ))}
  </nav>

  <div class="sidebar-actions" aria-label="Contact links">
    <a href={`mailto:${profile.email}`}>Email</a>
    <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    <a href={profile.cv} target="_blank" rel="noreferrer">CV</a>
  </div>
</aside>
